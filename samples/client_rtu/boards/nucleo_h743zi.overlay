/*
 * Copyright (c) 2026 nanoMODBUS Contributors
 * SPDX-License-Identifier: MIT
 *
 * USART2 is the Modbus RTU bus on PD5 (TX) / PD6 (RX). The console uses the
 * ST-LINK virtual COM port (USART3), so the two do not conflict.
 *
 * PD4 drives the RS-485 transceiver RE/DE pin in software GPIO mode.
 * Because RE (active-low) and DE (active-high) are tied together on this
 * transceiver, a single active-high GPIO acts as both: high = TX, low = RX.
 */

/ {
	aliases {
		modbus-uart = &usart2;
		modbus0 = &modbus0;
	};
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";

	modbus0: modbus0 {
		compatible = "nanomodbus,serial";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		de-gpios = <&gpiod 4 GPIO_ACTIVE_HIGH>;
		de-mode = "auto";
		rx-mode = "auto";

		client_target: slave@1 {
			reg = <1>;
		};
	};
};
