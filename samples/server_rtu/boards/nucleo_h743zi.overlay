 * Copyright (c) 2026 nanoMODBUS Contributors
 * SPDX-License-Identifier: MIT
 *
 * USART2 on the Nucleo-H743ZI is wired to the ST-LINK virtual COM port.
 * PD4 drives the RS-485 transceiver RE/DE pin in software GPIO mode.
 * Because RE (active-low) and DE (active-high) are tied together on this
 * transceiver, a single active-high GPIO acts as both: high = TX, low = RX.
 *
 * The two DMA channels let the transport use NMBS_Z_SERIAL_RX_ASYNC.
 */

/ {
	aliases {
		modbus-uart = &usart2;
		modbus0 = &modbus0;
	};
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	dmas = <&dmamux1 2 44 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 3 43 STM32_DMA_PERIPH_RX>;
	dma-names = "tx", "rx";
	status = "okay";

	modbus0: modbus0 {
		compatible = "nanomodbus,serial";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		de-gpios = <&gpiod 4 GPIO_ACTIVE_HIGH>;
		de-mode = "auto";
		rx-mode = "auto";

		server_node: slave@1 {
			reg = <1>;
		};
	};
};

&dma1 {
	status = "okay";
};

&dma2 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};
