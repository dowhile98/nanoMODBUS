/ {
	aliases {
		modbus-bus1 = &usart2;
		modbus-bus2 = &uart4;
		modbus0 = &modbus0;
		modbus1 = &modbus1;
	};
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";

	modbus0: modbus0 {
		compatible = "nanomodbus,serial";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		de-mode = "none";
		rx-mode = "irq";

		bus1_slave: slave@1 {
			reg = <1>;
		};
	};
};

&uart4 {
	pinctrl-0 = <&uart4_tx_pc10 &uart4_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";

	modbus1: modbus1 {
		compatible = "nanomodbus,serial";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		de-mode = "none";
		rx-mode = "irq";

		bus2_slave: slave@2 {
			reg = <2>;
		};
	};
};

&mac {
	status = "okay";
};
